# Copy to .env and fill in. Compose reads .env automatically.

# Must match the tunnel's public hostname — the OAuth redirect is derived from
# it and registered with every instance.
# PORTAL_BASE_URL=https://p.neodb.net

# Instance list for the picker, refreshed in the background when a pairing code
# is generated. Set it empty to fetch nothing and pin the built-in list.
# PORTAL_SERVERS_URL=https://neodb.net/servers.json
# PORTAL_SERVERS_REFRESH=60
